# Скопируйте этот файл в .env и заполните. Настоящие ключи пишем ТОЛЬКО в .env!

# Токен бота MAX
BOT_TOKEN=
# Ключ авторизации GigaChat API (developers.sber.ru/studio → проект → «Получить ключ»)
GIGACHAT_AUTH_KEY=

# Модели GigaChat (можно не менять)
GIGACHAT_MODEL=GigaChat
GIGACHAT_TASK_MODEL=GigaChat-2-Pro
GIGACHAT_CHECK_MODEL=GigaChat-2-Pro
GIGACHAT_VISION_MODEL=GigaChat-2-Pro

# Адрес веб-версии, который бот присылает кнопкой «Веб-кабинет»
WEB_URL=http://localhost:8000
