# Токен бота MAX (business.max.ru → Чат-боты → ⋮ → Настройки)
BOT_TOKEN=
# Публичный HTTPS-адрес, где работает контейнер (нужен для webhook)
PUBLIC_URL=
# polling — бот сам опрашивает MAX (работает везде); webhook — MAX присылает события на PUBLIC_URL
BOT_MODE=polling

# Yandex AI Studio: API-ключ сервисного аккаунта и ID каталога (b1g...)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# 1 — можно открыть мини-приложение в обычном браузере без MAX (только для разработки!)
DEV_MODE=0
# Домен сервера для HTTPS (Caddy). Без своего домена: IP с дефисами + .sslip.io, например 51-250-10-20.sslip.io
DOMAIN=
